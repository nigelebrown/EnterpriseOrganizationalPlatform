# Example only. DO NOT store live credentials here; use a vault/environment injection.
APP_ENV=production
DB_HOST=tcp:sql2019-ag-listener.example.internal,1433
DB_NAME=JcfEnterpriseRegistry
DB_USER=SET_VIA_SECRETS
DB_PASSWORD=SET_VIA_SECRETS
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_AG_ENABLED=true
DB_CONNECT_TIMEOUT=10
# SQL Server 2019 Express DEV: DB_AG_ENABLED=false, DB_HOST=tcp:dev-sql-host,1433
AUTH_ISSUER=https://identity.example.internal/realms/jcf
AUTH_AUDIENCE=jcf-enterprise-registry
AUTH_JWKS_URL=https://identity.example.internal/realms/jcf/protocol/openid-connect/certs
ADMIN_OIDC_CLIENT_ID=jcf-registry-admin-spa
ADMIN_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.internal/realms/jcf/protocol/openid-connect/auth
ADMIN_OIDC_TOKEN_ENDPOINT=https://identity.example.internal/realms/jcf/protocol/openid-connect/token
ADMIN_REDIRECT_URI=https://registry.example.internal/admin
ADMIN_OIDC_SCOPE=openid profile registry.read registry.write registry.approve registry.apply
CORS_ORIGINS=https://onboarding.example.internal
